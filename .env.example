# Local secrets — copy to .env if needed. Never commit .env.

# Baserow
BASEROW_DATABASE_TOKEN=
BASEROW_EMAIL=
BASEROW_PASSWORD=

# Netlify function env (set in Netlify UI for production)
GOOGLE_PLACES_API_KEY=

# Review Reply Writer — OpenAI-compatible (OpenRouter recommended)
LLM_API_KEY=
# or: OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v3.2
LLM_FALLBACK_MODEL=google/gemini-2.0-flash-lite-001
LLM_SITE_URL=https://grow-local-business.netlify.app
LLM_APP_NAME=Grow Local

# Operator lead alerts (Netlify function notify-lead.js — emails Craig, not end users)
SMTP2GO_API_KEY=
NOTIFY_TO=hello@growlocalbusiness.co.uk
NOTIFY_FROM=hello@growlocalbusiness.co.uk
